# Copy thành .env rồi điền key (file .env không được commit)
# Lấy API key tại https://opencode.ai/console → API keys (cần gói OpenCode Go)
OPENCODE_API_KEY=

# YouTube Data API v3 (chỉ nghiên cứu nội dung công khai; không upload)
YOUTUBE_API_KEY=

# File OAuth Client loại Desktop, lưu ngoài Git (cho báo cáo Analytics chủ kênh)
GOOGLE_OAUTH_CLIENT_FILE=
